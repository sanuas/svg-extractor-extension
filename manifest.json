{
  "manifest_version": 3,
  "name": "SVG Extractor",
  "version": "1.0",
  "description": "Extract and download SVGs from Lottie players and other web pages. Developed by ITS - Info Twist Solutions (its.net.in).",
  "permissions": [
    "scripting","activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}